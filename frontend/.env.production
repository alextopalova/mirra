# Applied to `vite build` only (mode=production); `npm run dev` still reads
# .env and talks to your local backend.
#
# A production build of this frontend is deployed to static hosting with no
# Python service behind it, so it has to run entirely on the bundled mock
# catalog and the garment photos in public/garments — both mirrored from
# backend/ by `backend/scripts/sync_mock_catalog.py`.
#
# To point a deployment at a real API instead, set VITE_USE_MOCKS=false and
# VITE_API_BASE=https://your-backend in the hosting platform's environment
# variables. Those arrive as process.env, which Vite applies *after* .env
# files, so they win over this without any code change.
VITE_USE_MOCKS=true
